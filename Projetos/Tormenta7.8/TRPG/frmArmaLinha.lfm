<?xml version="1.0" encoding="UTF-8"?>
<form name="frmArmaLinha" height="28" theme="light">
  <layout align="client" height="28">

    <edit align="left" width="140" field="arma"/>
    <edit align="left" width="48"  field="ataque"  horzTextAlign="center"/>
    <edit align="left" width="60"  field="dano"    horzTextAlign="center"/>
    <edit align="left" width="52"  field="critico" horzTextAlign="center"/>
    <edit align="left" width="48"  field="dist"    horzTextAlign="center"/>
    <edit align="left" width="62"  field="tipo"    horzTextAlign="center"/>
    <edit align="left" width="40"  field="peso" type="number" min="0" max="9999" horzTextAlign="center"/>

    <button align="left" width="24" text="X" hint="Excluir arma">
      <event name="onClick">
        if sheet ~= nil then
          local root = ndb.getRoot(sheet);
          ndb.deleteNode(sheet);
          if root ~= nil then
            root.__recalc03 = (tonumber(root.__recalc03) or 0) + 1;
          end;
        end;
      </event>
    </button>

    <!-- Recalcula carga sempre que o peso mudar -->
    <dataLink fields="{'peso'}">
      <event name="onChange">
        if sheet ~= nil then
          local root = ndb.getRoot(sheet);
          if root ~= nil then
            root.__recalc03 = (tonumber(root.__recalc03) or 0) + 1;
          end;
        end;
      </event>
    </dataLink>
  </layout>
</form>
