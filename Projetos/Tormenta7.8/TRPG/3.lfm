<?xml version="1.0" encoding="UTF-8"?>
<form name="Tormenta03" align="client" theme="light" lockWhileNodeIsLoading="true">
	<scrollBox align="client">
		<layout name="page" align="none" left="0" top="0" width="1010" height="700" margins="{left=0,top=0,right=0,bottom=0}">
			<rectangle align="client" color="LightGray" xradius="10" yradius="10"/>
    		<layout name="content" align="client" margins="{top=8,bottom=8}">
				<!-- ===== ARMAS ===== -->
				<layout align="top" height="170" margins="{top=8,bottom=4}">
					<rectangle align="client" color="Gray" xradius="6" yradius="6"/>
					<layout align="top" height="28" margins="{left=6,right=6,top=6,bottom=2}">
						<rectangle align="client" color="Black" xradius="4" yradius="4"/>
						<label align="client" fontSize="14" fontStyle="bold" fontColor="white" horzTextAlign="center" text="ARMAS"/>
					</layout>

					<layout align="top" height="24" margins="{left=6,right=6,top=0,bottom=2}">
						<button align="left" width="160" text="Adicionar Arma">
							<event name="onClick"> self.rclArmas:append(); </event>
						</button>
						<label align="left" width="200" text="(peso em kg)"/>
					</layout>

					<layout align="top" height="20" margins="{left=6,right=6,top=0,bottom=0}">
						<label align="left" width="226" fontStyle="bold" text="Arma"/>
						<label align="left" width="55" fontStyle="bold" horzTextAlign="center" text="Ataque"/>
						<label align="left" width="85" fontStyle="bold" horzTextAlign="center" text="Dano"/>
						<label align="left" width="70" fontStyle="bold" horzTextAlign="center" text="Crítico"/>
						<label align="left" width="70" fontStyle="bold" horzTextAlign="center" text="Dist."/>
						<label align="left" width="90" fontStyle="bold" horzTextAlign="center" text="Tipo"/>
						<label align="left" width="60" fontStyle="bold" horzTextAlign="center" text="Peso"/>
					</layout>

					<recordList name="rclArmas" field="listaArmas" templateForm="frmArmaLinha" align="top" height="120" margins="{left=6,right=6,top=0,bottom=6}" selectable="true"/>
				</layout>

				<!-- ===== ARMADURA / ESCUDO (igual ficha editável) ===== -->
				<layout align="top" height="150" margins="{top=0,bottom=4}">
					<rectangle align="client" color="Gray" xradius="6" yradius="6"/>

					<layout align="top" height="28" margins="{left=6,right=6,top=6,bottom=2}">
						<rectangle align="client" color="Black" xradius="4" yradius="4"/>
						<label align="client" fontSize="14" fontStyle="bold" fontColor="white" horzTextAlign="center" text="ARMADURA / ESCUDO"/>
					</layout>

					<layout align="top" height="24" margins="{left=6,right=6,top=0,bottom=2}">
						<button align="left" width="170" text="Adicionar Armadura">
						<event name="onClick">
							local n = self.rclDefesas:append();
							if n ~= nil then n.categoria = "Armadura"; end;
						</event>
						</button>

						<button align="left" width="170" margins="{left=8}" text="Adicionar Escudo">
						<event name="onClick">
							local n = self.rclDefesas:append();
							if n ~= nil then n.categoria = "Escudo"; end;
						</event>
						</button>
					</layout>

					<layout align="top" height="20" margins="{left=6,right=6,top=0,bottom=0}">
						<label align="left" width="110" fontStyle="bold" text="Categoria"/>
						<label align="left" width="190" fontStyle="bold" text="Nome"/>
						<label align="left" width="90"  fontStyle="bold" horzTextAlign="center" text="Bônus CA"/>
						<label align="left" width="140" fontStyle="bold" horzTextAlign="center" text="Bônus Máx. DES"/>
						<label align="left" width="120" fontStyle="bold" horzTextAlign="center" text="Penalidade"/>
						<label align="left" width="70"  fontStyle="bold" horzTextAlign="center" text="Peso"/>
					</layout>

					<recordList name="rclDefesas"
								field="listaDefesas"
								templateForm="frmDefesaLinha"
								align="top"
								height="60"
								margins="{left=6,right=6,top=0,bottom=6}"
								selectable="true"/>
				</layout>

				<!-- ===== EQUIPAMENTO (linha editável + descrição no detalhes) ===== -->
				<layout align="top" height="260" margins="{top=0,bottom=4}">
					<rectangle align="client" color="Gray" xradius="6" yradius="6"/>
					<!-- Título -->
					<layout align="top" height="28" margins="{left=6,right=6,top=6,bottom=2}">
						<rectangle align="client" color="Black" xradius="4" yradius="4"/>
						<label align="client" fontSize="14" fontStyle="bold" fontColor="white"
							horzTextAlign="center" text="EQUIPAMENTO"/>
					</layout>

					<!-- Botões -->
					<layout align="top" height="24" margins="{left=6,right=6,top=0,bottom=4}">
						<button align="left" width="190" text="Adicionar Item">
							<event name="onClick">
								local n = self.rclEquip:append();
								if n ~= nil then
									-- cria limpo
									n.nome = "";
									n.descricao = "";
									n.valor = "";
									n.peso = 0;

									-- seleciona e abre detalhes
									self.rclEquip.selectedNode = n;
									self.pnlEquipDetalhes.node = n;
									self.boxEquipDetalhes.node = n;
									self.pnlEquipDetalhes.visible = true;
								end;
							</event>
						</button>
					</layout>

					<!-- Conteúdo -->
					<layout align="client" margins="{left=6,right=6,top=0,bottom=6}">
						<rectangle align="client" color="Transparent" hitTest="true">
							<event name="onClick">
								self.rclEquip.selectedNode = nil;
								self.pnlEquipDetalhes.visible = false;
								self.pnlEquipDetalhes.node = nil;
								self.boxEquipDetalhes.node = nil;
							</event>
						</rectangle>
						<!-- ===== COLUNA ESQUERDA: LISTA EDITÁVEL ===== -->
						<layout align="left" width="560">

							<!-- Header -->
							<layout align="top" height="20" margins="{bottom=2}">
								<label align="left" width="334" fontStyle="bold" text="Nome"/>
								<label align="left" width="100" fontStyle="bold" horzTextAlign="center" text="Valor"/>
								<label align="left" width="70"  fontStyle="bold" horzTextAlign="center" text="Peso"/>
								<label align="left" width="26"  fontStyle="bold" horzTextAlign="center" text=""/>
							</layout>

							<!-- Lista -->
							<recordList name="rclEquip"
										field="listaEquipamentos"
										templateForm="frmEquipLinha"
										align="client"
										selectable="true">
								<event name="onSelect">
									local node = self.rclEquip.selectedNode;

									self.pnlEquipDetalhes.node = node;
									self.boxEquipDetalhes.node = node;
									self.pnlEquipDetalhes.visible = (node ~= nil);
								</event>
							</recordList>
						</layout>

						<!-- ===== COLUNA DIREITA: DETALHES (SÓ DESCRIÇÃO) ===== -->
						<layout name="pnlEquipDetalhes" align="left" width="420" margins="{left=8}" visible="false">
							<rectangle align="client" color="LightGray" xradius="6" yradius="6"/>

							<layout align="top" height="26" margins="{left=6,right=6,top=6,bottom=2}">
								<label align="client" fontStyle="bold" horzTextAlign="center"
									text="Detalhes do Item: $(nome)"/>
							</layout>

							<layout align="client" margins="{left=6,right=6,top=0,bottom=6}">
								<layout name="boxEquipDetalhes" align="client">
									<label align="top" height="18" fontStyle="bold" text="Descrição"/>
									<textEditor align="client" field="descricao"/>
								</layout>
							</layout>
						</layout>

					</layout>
				</layout>

				<!-- ===== CARGA (automático) + DINHEIRO + ANOTAÇÕES ===== -->
				<layout align="top" height="110" margins="{top=0,bottom=8}">
					<rectangle align="client" color="Gray" xradius="6" yradius="6"/>

					<layout align="top" height="28" margins="{left=6,right=6,top=6,bottom=2}">
						<rectangle align="client" color="Black" xradius="4" yradius="4"/>
						<label align="client" fontSize="14" fontStyle="bold" fontColor="white" horzTextAlign="center" text="CARGA / DINHEIRO / ANOTAÇÕES"/>
					</layout>

					<layout align="client" margins="{left=6,right=6,top=0,bottom=6}">
						<!-- coluna esquerda: carga -->
						<layout align="left" width="360">
							<label align="top" height="18" fontStyle="bold" text="Carga (regra automática)"/>
							<label align="top" height="18" text="Peso total:"/>
							<edit align="top" height="24" field="pesototal" type="number" min="0" max="999999" horzTextAlign="center" canFocus="false"/>

							<label align="top" height="18" text="Sem penalidade até:"/>
							<edit align="top" height="24" field="cargaSemPenal" type="number" min="0" max="999999" horzTextAlign="center" canFocus="false"/>

							<label align="top" height="18" text="Máximo:"/>
							<edit align="top" height="24" field="cargaMaxima" type="number" min="0" max="999999" horzTextAlign="center" canFocus="false"/>

							<label align="top" height="18" text="Deslocamento efetivo:"/>
							<edit align="top" height="24" field="deslocamentoEfetivo" canFocus="false" horzTextAlign="center"/>

							<label align="top" height="18" text="Status:"/>
							<edit align="top" height="24" field="cargaStatus" canFocus="false" horzTextAlign="center"/>
						</layout>

						<!-- coluna meio: dinheiro -->
						<layout align="left" width="240" margins="{left=10}">
							<label align="top" height="18" fontStyle="bold" text="Dinheiro"/>
							<label align="top" height="18" text="T$ (Cobre)"/>
							<edit align="top" height="24" field="totalCobre" type="number" min="0" max="999999" horzTextAlign="center"/>
							<label align="top" height="18" text="TP (Prata)"/>
							<edit align="top" height="24" field="totalPrata" type="number" min="0" max="999999" horzTextAlign="center"/>
							<label align="top" height="18" text="TO (Ouro)"/>
							<edit align="top" height="24" field="totalOuro" type="number" min="0" max="999999" horzTextAlign="center"/>
							<label align="top" height="18" text="TL (Platina)"/>
							<edit align="top" height="24" field="totalPlatina" type="number" min="0" max="999999" horzTextAlign="center"/>
						</layout>

						<!-- coluna direita: anotações -->
						<layout align="left" width="360" margins="{left=10}">
							<label align="top" height="18" fontStyle="bold" text="Anotações"/>
							<textEditor align="client" field="eqanotacoes"/>
						</layout>
					</layout>
				</layout>
			</layout>
		</layout>
	</scrollBox>
</form>
