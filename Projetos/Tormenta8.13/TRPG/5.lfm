<?xml version="1.0" encoding="UTF-8"?>
<form name="Tormenta05" width="1010" height="700" minWidth="700" maxWidth="1280" align="client" theme="light" lockWhileNodeIsLoading="true" onShow="TRPG_scheduleScale(self.sbMain05, self.lytCanvas05);" onResize="TRPG_scheduleScale(self.sbMain05, self.lytCanvas05);" onNodeReady="TRPG_scheduleScale(self.sbMain05, self.lytCanvas05);">
