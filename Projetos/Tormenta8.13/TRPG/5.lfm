                <textEditor left="0" top="30" width="300" height="328" fontColor="black" field="personalidade" />
                <rectangle left="435" top="3" color="Black" width="93" height="28" xradius="2" yradius="2" />
                <label left="439" top="6" width="100" height="20" fontSize="18.0" fontStyle="bold" fontColor="white" text="Aparência" />
                <textEditor left="334" top="30" width="300" height="328" fontColor="black" field="aparencia" />
                <rectangle left="770" top="3" color="Black" width="97" height="28" xradius="2" yradius="2" />
