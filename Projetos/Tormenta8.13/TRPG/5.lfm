<?xml version="1.0" encoding="UTF-8"?>
<form name="Tormenta05" align="client" theme="light" lockWhileNodeIsLoading="true" onResize="TRPG_updateScale(self, self.lytCanvas05);" onNodeReady="TRPG_updateScale(self, self.lytCanvas05);">
    <style>
        label {
            textTrimming: none;
        }
        button {
            textTrimming: none;
        }
    </style>
    <scrollBox align="client">
        <layout name="lytCanvas05" align="none" left="0" top="0" width="1010" height="700" margins="{left=0,top=0,right=0,bottom=0}">
            <rectangle width="1010" height="700" color="LightGray" xradius="10" yradius="10" />
            <layout left="10" top="8" width="980" height="300">
                <rectangle left="1" top="230" color="#333333" width="280" height="70" xradius="2" yradius="2" />
                <rectangle left="5" top="235" color="#999999" width="270" height="60" xradius="2" yradius="2" />
