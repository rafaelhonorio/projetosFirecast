                <label left="18" top="271" width="120" height="25" fontSize="10" fontColor="white" text="Experiência Próximo Nível" />
                <edit left="146" top="266" width="120" height="25" name="XPNivel" field="XPNivel" type="number" horzTextAlign="center" fontColor="black" fontSize="15.0" fontStyle="bold" />
                <rectangle left="84" top="3" color="Black" width="115" height="28" xradius="2" yradius="2" />
