<?xml version="1.0" encoding="UTF-8"?>
<form name="Tormenta01" width="1010" height="700" minWidth="700" maxWidth="1280" align="client" theme="light" lockWhileNodeIsLoading="true" onShow="TRPG_scheduleScale(self.sbMain01, self.lytCanvas01);" onResize="TRPG_scheduleScale(self.sbMain01, self.lytCanvas01);" onNodeReady="TRPG_scheduleScale(self.sbMain01, self.lytCanvas01); desCalculos(); recalcAll();">
    <style>
        label {
            textTrimming: none;
        }
        button {
            textTrimming: none;
        }
    </style>
    <scrollBox align="client" name="sbMain01">
        <template name="Principal">
            <rectangle left="5" top="0" color="Black" width="155" height="25" xradius="2" yradius="2" />
            <label left="8" top="4" width="155" height="20" text="$(texto)" horzTextAlign="leading" fontSize="15.0" fontStyle="bold" fontColor="white" />
            <edit left="175" top="0" width="30" height="25" field="$(field)" type="number" min="-999" max="999" horzTextAlign="center" fontSize="15.0" fontStyle="bold" fontColor="black" />
            <edit left="210" top="0" width="30" height="25" name="$(field2)" field="$(field2)" type="number" min="-999" max="999" horzTextAlign="center" fontSize="15.0" fontColor="black" fontStyle="bold" hitTest="false" />
            <edit left="245" top="0" width="30" height="25" field="$(field3)" type="number" min="-999" max="999" horzTextAlign="center" fontSize="15.0" fontColor="black" fontStyle="bold" />
        </template>
