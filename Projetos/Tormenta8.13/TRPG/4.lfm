<?xml version="1.0" encoding="UTF-8"?>
<form name="Tormenta04" align="client" theme="light" lockWhileNodeIsLoading="true" onResize="TRPG_updateScale(self.sbMain04, self.lytCanvas04);" onNodeReady="TRPG_updateScale(self.sbMain04, self.lytCanvas04);">
    <style>
        label {
            textTrimming: none;
        }
        button {
            textTrimming: none;
        }
    </style>
    <scrollBox align="client" name="sbMain04">
        <layout name="lytCanvas04" align="none" left="0" top="0" width="1010" height="700" margins="{left=0,top=0,right=0,bottom=0}">
            <rectangle width="1010" height="700" color="LightGray" xradius="10" yradius="10" />
            <rectangle left="373" top="10" color="#333333" width="265" height="50" xradius="2" yradius="2" />
            <rectangle left="378" top="15" color="#999999" width="255" height="40" xradius="2" yradius="2" />
            <rectangle left="397" top="28" color="Black" width="90" height="25" xradius="2" yradius="2" />
            <label left="429" top="22" width="35" height="25" fontSize="14" fontStyle="bold" fontColor="white" text="PM" />
            <label left="404" top="33" width="90" height="25" fontSize="10" fontColor="white" text="Pontos de Magia" />
            <rectangle left="507" top="16" color="Black" width="28" height="15" xradius="2" yradius="2" />
            <label left="509" top="18" width="28" height="8" fontSize="10" fontStyle="bold" fontColor="white" text="Total" />
            <edit left="491" top="28" width="60" height="25" name="totalPM" field="totalPM" type="number" horzTextAlign="center" fontColor="black" fontSize="15.0" fontStyle="bold" />
            <rectangle left="564" top="16" color="Black" width="38" height="15" xradius="2" yradius="2" />
            <label left="568" top="18" width="38" height="8" fontSize="10" fontStyle="bold" fontColor="white" text="Atuais" />
            <edit left="553" top="28" width="60" height="25" name="atuaisPM" field="atuaisPM" type="number" horzTextAlign="center" fontColor="black" fontSize="15.0" fontStyle="bold" />
            <rectangle left="175" top="46" color="Black" width="160" height="28" xradius="2" yradius="2" />
            <label left="183" top="47" width="160" height="23" fontSize="16.0" fontStyle="bold" fontColor="white" text="Magias Conhecidas" />
            <layout left="10" top="72" width="490" height="615">
                <textEditor align="client" field="mconhecidas" fontColor="black" fontStyle="bold" />
            </layout>
            <rectangle left="675" top="46" color="Black" width="160" height="28" xradius="2" yradius="2" />
            <label left="683" top="47" width="160" height="23" fontSize="16.0" fontStyle="bold" fontColor="white" text="Magias Preparadas" />
            <layout left="510" top="72" width="490" height="615">
                <textEditor align="client" field="mpreparadas" fontColor="black" fontStyle="bold" />
            </layout>
        </layout>
    </scrollBox>
    <script>
-- === Responsividade (Firecast 8.13 / SDK 3.7) ===
        -- Mantém o layout legado (1010px) e aplica escala automática em telas menores.
        if TRPG_updateScale == nil then
            require("system.lua");
            function TRPG_updateScale(container, canvas)
                if container == nil then return end
                canvas = canvas or (container.parent and (container.parent.lytCanvas or container.parent.page)) or container.lytCanvas or container.page
                if canvas == nil then return end
                local baseW = tonumber(canvas.width) or 1010
                local availW = tonumber(container.width) or (container.parent and tonumber(container.parent.width)) or baseW
                availW = availW - 20
                if availW &lt;= 0 then return end

                local scale = availW / baseW
                if scale &gt; 1 then scale = 1 end
                if scale &lt; 0.60 then scale = 0.60 end  -- evita ficar ilegível demais

                canvas.scale = scale

                local visW = baseW * scale
                local left = (availW + 20 - visW) / 2
                if left &lt; 0 then left = 0 end
                canvas.left = left
            end
        end
</script>
</form>